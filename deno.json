{
  "tasks": {
    "start": "deno run -A --watch=static/,routes/ dev.ts",
    "build": "deno task tailwind:build && deno run -A dev.ts build",
    "preview": "deno run -A main.ts",
    "tailwind:build": "deno run -A npm:tailwindcss@3.4.1 -i static/styles.css -o static/styles.min.css --minify",
    "tailwind:watch": "deno run -A npm:tailwindcss@3.4.1 -i static/styles.css -o static/styles.min.css --watch"
  },
  "imports": {
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "preact": "https://esm.sh/preact@10.22.0",
    "preact/": "https://esm.sh/preact@10.22.0/",
    "preact-render-to-string": "https://esm.sh/preact-render-to-string@5.2.1?external=preact",
    "tailwindcss": "npm:tailwindcss@3.4.1",
    "tailwindcss/": "npm:/tailwindcss@3.4.1/",
    "tailwindcss/plugin": "npm:/tailwindcss@3.4.1/plugin.js",
    "@preact/signals": "https://esm.sh/*@preact/signals@1.2.2",
    "@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.5.1"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "compilerOptions": { "jsx": "react-jsx", "jsxImportSource": "preact" }
}
